# Zkopírujte na `.env` (nebo nastavte jako proměnné prostředí u hostingu).

# Port, na kterém web běží (hosting ho většinou nastaví sám).
PORT=3000

# Kam se ukládají odpovědi. Na hostingu nastavte na cestu připojeného disku,
# aby data přežila restart/nasazení. Např. na Renderu: /var/data
DATA_DIR=./data

# Přihlašovací údaje pro přehled odpovědí (/admin a /api/rsvps).
# Bez hesla jsou tyto stránky veřejné!
ADMIN_USER=admin
ADMIN_PASSWORD=zvolte-silne-heslo
